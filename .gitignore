gradlew.bat
# Gradle wrapper: everything else under gradle/ ignored (caches etc.), but the wrapper
# jar+properties are committed so `./gradlew` works with no local Gradle install.
gradle/*
!gradle/wrapper/
gradle/wrapper/*
!gradle/wrapper/gradle-wrapper.properties
.idea/
.aswb/
.ijwb/
bazel-*
build/
# Gradle's own per-project cache/state dir (distinct from gradle/wrapper/ above).
.gradle/

# FileWorkspaceTest's with_symlinks fixture is checked in as a tarball (symlinks don't
# survive git checkout reliably cross-platform) and extracted here at test-run time by
# extractWorkspace(). Bazel's sandboxed test execution never touches the real source
# tree, so this only shows up as working-tree pollution under Gradle.
core/src/test/resources/file_workspaces/with_symlinks/a/
core/src/test/resources/file_workspaces/with_symlinks/a_symlink
core/src/test/resources/file_workspaces/with_symlinks/foo/
core/src/test/resources/file_workspaces/with_symlinks/workspace.spice.yml
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.jar
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
