load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

kt_jvm_library(
    name = "model",
    srcs = glob(
        ["src/main/**/*.kt"],
        exclude = ["src/main/**/test/*.kt"],
    ),
    visibility = ["//:__subpackages__"],
    deps = [
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
    ],
)

kt_jvm_library(
    name = "test",
    testonly = True,
    srcs = glob(["src/main/**/test/*.kt"]),
    visibility = ["//:__subpackages__"],
    deps = [
        "//model",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
    ],
)
